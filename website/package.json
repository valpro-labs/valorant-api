{
  "name": "valorant-api-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run docs:api",
    "prebuild": "npm run docs:api",
    "docs:api": "typedoc && node scripts/post-process.mjs",
    "build": "next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "^16.7.16",
    "fumadocs-mdx": "^14.2.14",
    "fumadocs-ui": "^16.7.16",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.9",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.3"
  }
}
